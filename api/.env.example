# Connection to app_db (conversation logs, tickets, API state).
DATABASE_URL=postgres://postgres:change-me@postgres:5432/app_db

# Read-only connection to n8n's internal database, used only for the
# execution-count health metric. Never used to write.
N8N_DATABASE_URL=postgres://postgres:change-me@postgres:5432/n8n

# Base URL the n8n workflow posts callbacks to.
N8N_CALLBACK_BASE_URL=http://api:3000

# Shared secret for POST /internal/notify. Server-to-server only.
INTERNAL_CALLBACK_SECRET=change-me

# Directory containing NNN_*.sql migration files.
MIGRATIONS_DIR=./db/migrations

NODE_ENV=development
PORT=3000